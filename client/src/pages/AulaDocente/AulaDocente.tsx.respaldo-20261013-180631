type Grupo={id_grupo:string;nombre_grupo:string;total_alumnos:number};
type Alumno={id_usuario:string;nombre_completo:string;usuario:string};
type Permiso={actividad_codigo:string;habilitada:boolean;id_alumno?:string};
type Progreso={id_usuario:string;actividad_codigo:string;aciertos:number;total_preguntas:number;precision:string;completada:boolean;intentos:number;tiempo_segundos:number;fecha_ultimo_intento:string;respuestas:Record<string,unknown>};
type Detail={alumnos:Alumno[];permisos:Permiso[];excepciones:Permiso[];progreso:Progreso[]};
async function api(url:string,init?:RequestInit){const r=await fetch('/api/aula'+url,{...init,headers:{Authorization:'Bearer '+getAuthToken(),'Content-Type':'application/json'},cache:'no-store'});const d=await r.json();if(!r.ok)throw Error(d.mensaje||'No se pudo completar la operación.');return d;}
function answerText(value:unknown):string{if(value==null)return 'Sin respuesta';if(typeof value!=='object')return String(value);const p=value as Record<string,unknown>;if('x' in p&&'y' in p)return `Punto 1: (${p.x}, ${p.y})${'x2' in p?`; punto 2: (${p.x2}, ${p.y2})`:''}`;return Object.values(p).map(answerText).join(', ');}
function evidence(p:Progreso):[string,string][]{
 const expansion=p.respuestas?.mission_expansion as {answers?:Record<string,unknown>;explanation?:string;reflection_rubric?:string}|undefined;
 const missions=missionCatalog as Record<string,{nativeCount:number;questions:{id:string;prompt:string}[]}>;
 const mission=missions[p.actividad_codigo];const rows:[string,string][]=[];
 if(expansion?.reflection_rubric)rows.push(['Criterio para revisar la explicación',expansion.reflection_rubric]);
 if(expansion?.explanation)rows.push(['Explicación del alumno · revisar con la rúbrica',expansion.explanation]);
 if(mission&&expansion?.answers)for(const [i,q] of mission.questions.entries())rows.push([`Reto ${mission.nativeCount+i+1}: ${q.prompt}`,answerText(expansion.answers[q.id])]);
 for(const [key,value] of Object.entries(p.respuestas||{})){
  if(/mission_expansion|previous_mission|schema|version|count|curriculum|tiempo|completad|xp|estrellas|fecha|intentos|progreso/.test(key))continue;
  rows.push(['Respuesta original · '+key.replace(/_/g,' '),answerText(value)]);
 }
 return rows;
}
export default function AulaDocente(){
 const [grupos,setGrupos]=useState<Grupo[]>([]),[grupo,setGrupo]=useState(''),[alumno,setAlumno]=useState(''),[world,setWorld]=useState(''),[detail,setDetail]=useState<Detail|null>(null),[selected,setSelected]=useState<string[]>([]),[busy,setBusy]=useState(false),[error,setError]=useState(''),[message,setMessage]=useState(''),[version,setVersion]=useState(0);
 const [view,setView]=useState<'permisos'|'desempeno'>('permisos'),[activity,setActivity]=useState(catalogo[0].codigo);
 useEffect(()=>{let alive=true;void api('/grupos').then(d=>{if(alive){setGrupos(d.grupos);setGrupo(g=>g||String(d.grupos[0]?.id_grupo||''))}}).catch(e=>{if(alive)setError(e.message)});return()=>{alive=false}},[]);
 useEffect(()=>{setDetail(null);setSelected([]);if(!grupo)return;const controller=new AbortController();void api('/grupos/'+grupo,{signal:controller.signal}).then(d=>{if(!controller.signal.aborted){setDetail(d);setError('')}}).catch(e=>{if(!controller.signal.aborted)setError(e.message)});return()=>controller.abort()},[grupo,version]);
 const visible=catalogo.filter(a=>!world||a.mundo===world);
 async function save(codes:string[],habilitada:boolean|null){setBusy(true);setMessage('');setError('');try{const d=await api('/grupos/'+grupo+'/permisos',{method:'PUT',body:JSON.stringify({actividades:codes,habilitada,id_alumno:alumno||null})});setMessage(d.mensaje);setSelected([]);setVersion(v=>v+1)}catch(e){setError(e instanceof Error?e.message:'No se pudieron guardar los permisos.')}finally{setBusy(false)}}
 function state(code:string){return alumno?detail?.excepciones.find(p=>String(p.id_alumno)===alumno&&p.actividad_codigo===code)?.habilitada??null:detail?.permisos.find(p=>p.actividad_codigo===code)?.habilitada??false;}
 const groupName=grupos.find(g=>String(g.id_grupo)===grupo)?.nombre_grupo;
 const alumnos=detail?.alumnos.filter(a=>!alumno||String(a.id_usuario)===alumno)||[];
 const rows=alumnos.map(a=>{const p=detail?.progreso.filter(p=>String(p.id_usuario)===String(a.id_usuario)&&p.actividad_codigo===activity).sort((a,b)=>new Date(b.fecha_ultimo_intento).getTime()-new Date(a.fecha_ultimo_intento).getTime())[0];return {a,p}});
 return <main className="mn-aula"><Link className="mn-aula-back" to="/dashboard-docente">← Volver al dashboard docente</Link><header className="mn-aula-hero"><div><span>MathNova · Control docente</span><h1>Tu aula, a tu ritmo</h1><p>Asigna alumnos a tus grupos y habilita las misiones que corresponden a tu planeación.</p></div><img src={hero} alt=""/></header><div className="mn-aula-actions"><Link to="/mis-grupos-docente">Administrar grupos y alumnos</Link><Link to="/crear-grupo-docente">Crear grupo</Link></div>
 {error&&<p role="alert" className="mn-aula-message">{error}</p>}{message&&<p role="status" className="mn-aula-message">{message}</p>}
 <section className="mn-aula-card mn-aula-filters"><label>Grupo<select aria-label="Grupo" value={grupo} onChange={e=>{setGrupo(e.target.value);setDetail(null);setSelected([]);setAlumno('');setMessage('')}}><option value="">Selecciona un grupo</option>{grupos.map(g=><option key={g.id_grupo} value={String(g.id_grupo)}>{g.nombre_grupo} · {g.total_alumnos} alumnos</option>)}</select></label><label>Aplicar a<select aria-label="Aplicar a" value={alumno} onChange={e=>{setAlumno(e.target.value);setSelected([]);setMessage('')}} disabled={!detail||busy}><option value="">Todo el grupo</option>{detail?.alumnos.map(a=><option key={a.id_usuario} value={String(a.id_usuario)}>{a.nombre_completo}</option>)}</select></label><label>Mundo<select value={world} onChange={e=>setWorld(e.target.value)}><option value="">Los tres mundos</option><option value="mathnumbers">MathNumbers</option><option value="mathgeometry">MathGeometry</option><option value="mathdata">MathData</option></select></label></section>
 <nav className="mn-aula-tabs"><button aria-pressed={view==='permisos'} onClick={()=>setView('permisos')}>Acceso a actividades</button><button aria-pressed={view==='desempeno'} onClick={()=>setView('desempeno')}>Desempeño y respuestas</button></nav>
 {!grupos.length&&!error&&<p>Crea un grupo y agrega alumnos registrados. Sus actividades permanecerán cerradas hasta que las habilites.</p>}
 {grupo&&!detail&&!error&&<p role="status">Cargando {groupName}…</p>}
 {detail&&view==='permisos'&&<section className="mn-aula-card"><h2>{alumno?'Permisos individuales':'Permisos del grupo'}</h2><p>{alumno?'Puedes habilitar o bloquear una misión para este alumno, o heredar el permiso del grupo. Un bloqueo individual prevalece sobre las habilitaciones de otros grupos.':'Al habilitar una actividad se abre para los alumnos actuales y futuros del grupo. Bloquear actividades del grupo retira las excepciones que las habilitaban en este grupo; los bloqueos individuales se conservan.'}</p><div className="mn-aula-actions"><button disabled={busy} onClick={()=>setSelected(visible.map(a=>a.codigo))}>Seleccionar las visibles</button><button disabled={!selected.length||busy} onClick={()=>save(selected,true)}>Habilitar seleccionadas</button><button disabled={!selected.length||busy} onClick={()=>save(selected,false)}>Bloquear seleccionadas</button>{alumno&&<button disabled={!selected.length||busy} onClick={()=>save(selected,null)}>Heredar del grupo</button>}</div><div className="mn-aula-table"><table><thead><tr><th>Elegir</th><th>Misión y aprendizaje</th><th>Acceso</th></tr></thead><tbody>{visible.map(a=><tr key={a.codigo}><td><input type="checkbox" aria-label={'Seleccionar '+a.titulo} checked={selected.includes(a.codigo)} onChange={e=>setSelected(v=>e.target.checked?[...v,a.codigo]:v.filter(c=>c!==a.codigo))}/></td><td><strong>{a.titulo}</strong><small>{a.mundo==="mathnumbers"?"MathNumbers":a.mundo==="mathgeometry"?"MathGeometry":"MathData"} · {a.contenido}</small><details><summary>Ver PDA{a.sintesis?" · Síntesis":""}</summary><p>{a.grado}</p>{a.nota&&<p>{a.nota}</p>}<ul>{a.pda.map(p=><li key={p}>{p}</li>)}</ul></details></td><td><select aria-label={'Acceso a '+a.titulo} value={state(a.codigo)===null?'heredar':state(a.codigo)?'abierta':'cerrada'} disabled={busy} onChange={e=>save([a.codigo],e.target.value==='heredar'?null:e.target.value==='abierta')}>{alumno&&<option value="heredar">Heredar del grupo</option>}<option value="cerrada">Bloqueada</option><option value="abierta">Habilitada</option></select>{alumno&&<small>Grupo: {detail.permisos.some(p=>p.actividad_codigo===a.codigo&&p.habilitada)?'habilitada':'bloqueada'}</small>}</td></tr>)}</tbody></table></div></section>}
 {detail&&view==='desempeno'&&<section className="mn-aula-card"><h2>Desempeño en la misión</h2><label>Actividad<select aria-label="Actividad" value={activity} onChange={e=>setActivity(e.target.value)}>{catalogo.map(a=><option key={a.codigo} value={a.codigo}>{a.titulo}</option>)}</select></label><button disabled={busy} onClick={()=>setVersion(v=>v+1)}>Actualizar desempeño</button><p>{rows.filter(r=>r.p?.completada).length} de {rows.length} alumnos completaron esta misión. Se muestra el mejor resultado guardado de cada alumno. La precisión automática es una evidencia; las explicaciones requieren revisión docente.</p><div className="mn-aula-table"><table><thead><tr><th>Alumno</th><th>Estado</th><th>Aciertos</th><th>Precisión</th><th>Intentos</th><th>Tiempo</th></tr></thead><tbody>{rows.map(({a,p})=><tr key={a.id_usuario}><td>{a.nombre_completo}</td><td>{!p?'Sin intentos':p.completada?'Completada':'En proceso'}</td><td>{p?`${p.aciertos}/${p.total_preguntas}`:'—'}</td><td>{p?Number(p.precision).toFixed(1)+' %':'—'}</td><td>{p?.intentos||'—'}</td><td>{p?Math.floor(p.tiempo_segundos/60)+' min '+(p.tiempo_segundos%60)+' s':'—'}</td></tr>)}</tbody></table></div>{rows.filter(r=>r.p).map(({a,p})=><details key={a.id_usuario} className="mn-aula-evidence"><summary>Respuestas de {a.nombre_completo}</summary><p>Última actividad registrada: {p&&new Date(p.fecha_ultimo_intento).toLocaleString('es-MX')}</p><dl>{evidence(p!).map(([key,value],i)=><div key={i}><dt>{key}</dt><dd>{value}</dd></div>)}</dl></details>)}</section>}
 </main>;
}
